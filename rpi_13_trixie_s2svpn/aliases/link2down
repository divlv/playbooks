#!/usr/bin/env bash
# link2down
# English comment: Bring down IPsec connection to Azure Gateway 2

###############################################################################
# Usage examples:
#   ./link2down                  # bring down azure-gw2 connection
#   ./link2down --help           # usage info
###############################################################################

# Help / usage
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  echo "Usage: $0"
  echo
  echo "Brings down IPsec connection to Azure Gateway 2."
  echo "Runs: ipsec down azure-gw2"
  exit 0
fi

COMMAND_TO_EXECUTE="ipsec down azure-gw2"

echo "Bringing down IPsec connection to Azure Gateway 2:"
echo "#########################################################################"
echo "$COMMAND_TO_EXECUTE"
echo "#########################################################################"

# Execute the command
eval "$COMMAND_TO_EXECUTE"
